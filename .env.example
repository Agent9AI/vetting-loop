# ── The Vetting Loop — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Public (exposed to browser) ───────────────────────────────────────────────

# Base URL of the Hono API Worker
# Local: http://localhost:8787
# Production: https://api.vettingloop.ke
NEXT_PUBLIC_API_URL=http://localhost:8787

# Clerk publishable key (safe to expose — starts with pk_)
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY

# Public app URL (used for OG image generation and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-side / Cloudflare Worker secrets ───────────────────────────────────
# These must be set via `wrangler secret put` for production.
# For local development, they can live in .env.

# Clerk secret key (starts with sk_)
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY

# Cloudflare D1 database ID
# Run: wrangler d1 create vetting-loop-db
# Then copy the database_id from the output
D1_DATABASE_ID=REPLACE_AFTER_RUNNING_WRANGLER_D1_CREATE

# Vectorize index name (default matches wrangler.toml)
VECTORIZE_INDEX=vetting-loop-docs

# Internal API secret — used to protect admin routes alongside Clerk auth
# Generate with: openssl rand -hex 16
# Set in production with: wrangler secret put API_INTERNAL_SECRET
API_INTERNAL_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# Mzalendo API key
# Request access at: https://mzalendo.com/api/
MZALENDO_API_KEY=REPLACE_WITH_MZALENDO_API_KEY
